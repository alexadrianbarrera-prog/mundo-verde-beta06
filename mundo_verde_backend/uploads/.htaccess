# Esta carpeta guarda archivos subidos por clientes (comprobantes de pago).
# Nunca debe poder ejecutar código PHP, aunque alguien logre subir un
# archivo con extensión .php disfrazado (pedidos_subir_comprobante ya
# valida extensión + mime real, esto es una segunda barrera).

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php\d)$">
    Require all denied
</FilesMatch>
